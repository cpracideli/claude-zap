# Copie as variáveis para a aba "Environment Variables" no Coolify.
# Nunca commite um arquivo .env real.

# ==========================================================
# 1. Mínimo obrigatório para Painel Web (Agent Control) + Claude Code
# ==========================================================
# Nome exibido nos prompts de memória/briefing (opcional)
OWNER_NAME=
# Senha de login no painel web Agent Control (stack único)
ADMIN_PASSWORD=troque-por-uma-senha-forte
# Token compartilhado entre a ponte e o painel (use um valor longo aleatório)
BRIDGE_ADMIN_TOKEN=troque-por-um-token-longo-aleatorio
# Token de assinatura Claude gerado com: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=
# Opcional: API key da Anthropic caso não use assinatura OAuth
ANTHROPIC_API_KEY=

# ==========================================================
# 2. Coolify opcional (habilita abas Variáveis, Logs, Restart/Deploy no painel)
# ==========================================================
COOLIFY_URL=
COOLIFY_TOKEN=
COOLIFY_APP_UUID=

# ==========================================================
# 3. Google Login + Web Push + URL pública (opcional)
# ==========================================================
# URL pública HTTPS do painel (ex.: https://agent.seudominio.com)
PUBLIC_URL=
SESSION_SECRET=
VAPID_SUBJECT=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# E-mails autorizados no login Google, separados por vírgula
ALLOWED_AUTH_EMAILS=

# ==========================================================
# 4. WhatsApp via WAHA (opcional — deixe vazio para usar só o Painel / Telegram / Discord / Slack)
# ==========================================================
WAHA_URL=
WAHA_API_KEY=
# Nome exato da sessão no WAHA (case-sensitive)
WAHA_SESSION=default
# Números autorizados a falar com o bot no WhatsApp (DDI+DDD+número, separados por vírgula)
ALLOWED_NUMBERS=
# Defina false se estiver compartilhando um número WAHA com outra instância (bloqueia envio para terceiros/grupos até conectar WAHA próprio no painel)
WHATSAPP_ALLOW_THIRD_PARTY=true
# Chave HMAC caso o webhook do WAHA seja exposto publicamente
WEBHOOK_HMAC_KEY=
STARTUP_NOTICE=true

# ==========================================================
# 5. Outros canais opcionais (Telegram, Discord, Slack)
# ==========================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USERS=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_ALLOWED_USERS=

# ==========================================================
# 6. Voz (STT / TTS) & E-mail nativos (opcional)
# ==========================================================
# Transcrição (STT): tenta Groq Whisper, depois OpenAI Whisper
GROQ_API_KEY=
STT_LANGUAGE=pt
# Síntese de voz (TTS): tenta Gemini TTS, OpenAI TTS e fallback offline espeak-ng
GEMINI_API_KEY=
OPENAI_API_KEY=
TTS_MODEL=
TTS_VOICE=Kore
# Envio de rascunhos de e-mail via AgentMail
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX=

# ==========================================================
# 7. Avançado / Opções do agente
# ==========================================================
TZ=America/Sao_Paulo
CLAUDE_PERMISSION_MODE=bypassPermissions
CLAUDE_ALLOWED_TOOLS=Read,Write,Edit,Glob,Grep,WebSearch,WebFetch,TodoWrite
CLAUDE_MODEL=
CLAUDE_EFFORT=
CLAUDE_TIMEOUT_SECONDS=1800
VAULT_KEY=
AI_MEMORY=on
AI_MEMORY_SERVER_URL=http://127.0.0.1:49374
OBSIDIAN_DIR=
# Ligações WhatsApp VoIP via WaCalls (sidecar pure-Go em ~/.local/bin/wacalls; 0 desativa)
WACALLS_ENABLED=1
WACALLS_PORT=8088
