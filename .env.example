# Copy the values into the Coolify service's "Environment Variables" tab.
# Never commit a real .env file.

# WhatsApp gateway (WAHA) that is already logged in to your number
WAHA_URL=https://your-waha.example.com
WAHA_API_KEY=change-me
WAHA_SESSION=default

# Only these numbers can talk to the bot (digits, with country code; separate with commas)
ALLOWED_NUMBERS=5511999998888

# Claude subscription token, generated with: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Optional: an API key instead of the subscription (leave empty to use the token above)
ANTHROPIC_API_KEY=

# Optional settings
CLAUDE_PERMISSION_MODE=bypassPermissions
CLAUDE_MODEL=
CLAUDE_EFFORT=
CLAUDE_TIMEOUT_SECONDS=1800
TZ=America/Sao_Paulo
